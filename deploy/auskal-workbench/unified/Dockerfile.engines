FROM auskal-rea:6.9.0
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libatomic1 python3 python3-venv openjdk-17-jre-headless chromium tesseract-ocr git file binutils unzip fonts-dejavu-core curl && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir 'lief==0.17.6' 'semgrep==1.185.0' 'androguard==4.1.4' 'jsbeautifier==2.0.3' 'reportlab==5.1.0' 'Pillow==13.0.0' 'playwright==1.65.1'
RUN mkdir -p /opt/jadx /opt/engines && curl -fL --retry 3 https://github.com/skylot/jadx/releases/download/v1.5.6/jadx-1.5.6.zip -o /tmp/jadx.zip && echo '545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974  /tmp/jadx.zip' | sha256sum -c - && unzip -q /tmp/jadx.zip -d /opt/jadx && rm /tmp/jadx.zip
RUN curl -fL --retry 3 https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz -o /tmp/gitleaks.tgz && echo '551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb  /tmp/gitleaks.tgz' | sha256sum -c - && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && rm /tmp/gitleaks.tgz
RUN curl -fL --retry 3 https://github.com/google/bundletool/releases/download/1.18.3/bundletool-all-1.18.3.jar -o /opt/engines/bundletool.jar && echo 'a099cfa1543f55593bc2ed16a70a7c67fe54b1747bb7301f37fdfd6d91028e29  /opt/engines/bundletool.jar' | sha256sum -c -
RUN /opt/venv/bin/pip freeze > /opt/engines/python-versions.txt
ENV PATH="/opt/venv/bin:/opt/jadx/bin:$PATH" HOME=/tmp PYTHONDONTWRITEBYTECODE=1 SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0
USER node
WORKDIR /output
ENTRYPOINT ["/opt/venv/bin/python","/app/unified/analyze.py"]

